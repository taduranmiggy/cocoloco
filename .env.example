// .env.example - Environment variables template
// Copy this file to .env.local and update values as needed

# Application
REACT_APP_NAME=CocoirStore
REACT_APP_ENVIRONMENT=development
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Features
REACT_APP_ENABLE_PAYMENT_GATEWAY=false
REACT_APP_ENABLE_EMAIL_VERIFICATION=false
REACT_APP_ENABLE_ANALYTICS=false

# Mock Data
REACT_APP_USE_MOCK_DATA=true
REACT_APP_MOCK_DELAY_MS=1000

# Storage
REACT_APP_ENABLE_LOCALSTORAGE=true
REACT_APP_CACHE_DURATION_MINUTES=60
